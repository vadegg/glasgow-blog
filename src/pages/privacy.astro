---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ORGANIZATION, SITE } from '../data/site';
import privacyPolicyHtml from '../content/legal/privacy-policy.html?raw';

const structuredData = [
  ORGANIZATION,
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Privacy Policy',
    url: `${SITE.url}/privacy/`,
    description: 'Privacy Policy for Glasgow Research Blog.'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: SITE.url
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Privacy Policy',
        item: `${SITE.url}/privacy/`
      }
    ]
  }
];
---

<BaseLayout
  title="Privacy Policy | Glasgow Research Blog"
  description="Privacy Policy for Glasgow Research Blog and Glazkov Research, Unipessoal LDA."
  structuredData={structuredData}
>
  <main class="shell page-wrap">
    <section class="card legal-card">
      <p class="hero-kicker">Legal</p>
      <div class="legal-embed" set:html={privacyPolicyHtml} />
    </section>
  </main>
</BaseLayout>
