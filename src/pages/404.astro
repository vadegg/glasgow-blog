---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title={`Page not found | ${SITE.name}`}
  description="The page you requested could not be found on Glasgow Research Blog."
  robots="noindex, nofollow"
>
  <main class="shell page-wrap">
    <section class="card hero-card" style="max-width: 760px; margin: 0 auto;">
      <p class="hero-kicker">404</p>
      <h1 class="hero-title">This page does not exist.</h1>
      <p class="hero-copy muted">
        The URL may be outdated, misspelled, or removed. Use the blog index to continue browsing published articles.
      </p>
      <div class="action-row" style="margin-top: 28px;">
        <a class="button-link" href="/blog/">Browse articles</a>
        <a class="button-link secondary" href="/">Back home</a>
      </div>
    </section>
  </main>
</BaseLayout>
